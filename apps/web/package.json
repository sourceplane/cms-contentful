{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "setup": "node ./lib/setup.js"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/typography": "0.5.9",
    "date-fns": "2.30.0",
    "next": "16.3.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.4.15",
    "contentful-import": "^10.5.7",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
